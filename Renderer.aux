\@writefile{toc}{\contentsline {paragraph}{Against the procedure in use.}{19}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Pricing technology.}{19}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces MATH-3D-SCPTOP against the volumetric benchmark on the 36 generated instances. \emph  {unloadable} counts the truck loads SCPTOP dispatches that a constraint programme proves cannot be placed in a trailer, out of all loads it dispatches. $\Delta z$ is the cost of MATH-3D-SCPTOP relative to SCPTOP.}}{20}{}\protected@file@percent }
\newlabel{tab:main}{{5}{20}{}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Results by instance factor. \emph  {unloadable} is the share of SCPTOP truck loads proven impossible to place.}}{20}{}\protected@file@percent }
\newlabel{tab:summary}{{6}{20}{}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Case study on the industrial RTI catalogue. \emph  {company} is PLC-SCPTOP over the configurations the planner derives from average demand mixes; \emph  {benchmark} is PLC-SCPTOP over a richer hand-drawn set (regular grids and two-zone layouts). A dash means the procedure could not serve the demand programme with its configurations.}}{21}{}\protected@file@percent }
\newlabel{tab:case}{{7}{21}{}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces MATH-3D-SCPTOP against the compact 3D-SCPTOP model, which is warm-started with the matheuristic's plan. The compact model is given 30 minutes and $|L|=3$ configurations per direction; \emph  {true gap} is the matheuristic's distance from the compact model's incumbent.}}{21}{}\protected@file@percent }
\newlabel{tab:exact}{{8}{21}{}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Pricing technology. The same matheuristic is run with the subproblem solved as a constraint programme (CP-SAT) and as a MILP with big-$M$ non-overlap (Gurobi), under identical budgets.}}{22}{}\protected@file@percent }
\newlabel{tab:oracle}{{9}{22}{}{table.9}{}}
\@writefile{toc}{\contentsline {paragraph}{On bounds, and what the method does not deliver.}{22}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Where each method belongs.}{22}{}\protected@file@percent }
